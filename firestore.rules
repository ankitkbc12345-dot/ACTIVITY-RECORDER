rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidServerTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Entity 1: SyncProfile (/users/{userId})
    function isValidSyncProfile(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             data.activeDeviceId is string &&
             data.activeDeviceId.size() >= 1 && data.activeDeviceId.size() <= 64 &&
             data.activeDeviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.totalSnapshots is int && data.totalSnapshots >= 0 &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    // Entity 2: CloudDeviceSnapshot (/users/{userId}/device_snapshots/{snapshotId})
    function isValidDeviceSnapshot(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.deviceId is string &&
             data.deviceId.size() >= 1 && data.deviceId.size() <= 64 &&
             data.deviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.deviceName is string &&
             data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
             data.deviceModel is string &&
             data.deviceModel.size() >= 1 && data.deviceModel.size() <= 80 &&
             data.appCount is int && data.appCount >= 0 &&
             data.activityCount is int && data.activityCount >= 0 &&
             data.callLogCount is int && data.callLogCount >= 0 &&
             (!('summaryNote' in data) || (data.summaryNote is string && data.summaryNote.size() <= 500)) &&
             data.syncStatus is string &&
             data.syncStatus in ['SYNCED', 'PAUSED'] &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    // Entity 3: CloudActivityRecord (/users/{userId}/activity_records/{recordId})
    function isValidActivityRecord(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.deviceId is string &&
             data.deviceId.size() >= 1 && data.deviceId.size() <= 64 &&
             data.deviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.recordCategory is string &&
             data.recordCategory in ['APP_EVENT', 'APP_INVENTORY', 'CALL_LOG'] &&
             data.title is string &&
             data.title.size() >= 1 && data.title.size() <= 120 &&
             data.subtitle is string &&
             data.subtitle.size() >= 1 && data.subtitle.size() <= 160 &&
             (!('detail' in data) || (data.detail is string && data.detail.size() <= 240)) &&
             data.eventDate is string &&
             data.eventDate.size() >= 1 && data.eventDate.size() <= 20 &&
             data.eventTime is string &&
             data.eventTime.size() >= 1 && data.eventTime.size() <= 20 &&
             data.recordedAtMillis is int && data.recordedAtMillis >= 0 &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'activeDeviceId', 'totalSnapshots', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'activeDeviceId', 'totalSnapshots', 'createdAt', 'updatedAt']) &&
                       isValidSyncProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidSyncProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'activeDeviceId', 'totalSnapshots', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /device_snapshots/{snapshotId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(snapshotId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(snapshotId) &&
                         incoming().keys().hasAll(['userId', 'deviceId', 'deviceName', 'deviceModel', 'appCount', 'activityCount', 'callLogCount', 'syncStatus', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'deviceId', 'deviceName', 'deviceModel', 'appCount', 'activityCount', 'callLogCount', 'summaryNote', 'syncStatus', 'createdAt', 'updatedAt']) &&
                         isValidDeviceSnapshot(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(snapshotId) &&
                         isValidDeviceSnapshot(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().deviceId == existing().deviceId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'deviceModel', 'appCount', 'activityCount', 'callLogCount', 'summaryNote', 'syncStatus', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(snapshotId);
      }

      match /activity_records/{recordId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(recordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(recordId) &&
                         incoming().keys().hasAll(['userId', 'deviceId', 'recordCategory', 'title', 'subtitle', 'eventDate', 'eventTime', 'recordedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'deviceId', 'recordCategory', 'title', 'subtitle', 'detail', 'eventDate', 'eventTime', 'recordedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidActivityRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(recordId) &&
                         isValidActivityRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().deviceId == existing().deviceId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['recordCategory', 'title', 'subtitle', 'detail', 'eventDate', 'eventTime', 'recordedAtMillis', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(recordId);
      }
    }
  }
}
